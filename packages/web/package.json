{
  "name": "@docai/web",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "check": "npm run lint:fix && npm run typecheck && npm run test",
    "verify": "npm run lint && npm run format:check && npm run typecheck && npm run build && npm run test:coverage",
    "lint": "eslint --no-error-on-unmatched-pattern src/ tests/ e2e/ .storybook/ *.config.ts",
    "lint:fix": "eslint --no-error-on-unmatched-pattern src/ tests/ e2e/ .storybook/ *.config.ts --fix",
    "format": "prettier --write src/ tests/ e2e/ .storybook/ *.config.ts",
    "format:check": "prettier --check src/ tests/ e2e/ .storybook/ *.config.ts",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build"
  },
  "dependencies": {
    "firebase": "^12.11.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.52.0",
    "@storybook/react": "^10.3.5",
    "@storybook/react-vite": "^10.3.0-alpha.16",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "http-server": "^14.1.1",
    "jsdom": "^29.0.1",
    "prettier": "^3.8.1",
    "storybook": "^10.3.0-alpha.16",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.0.0",
    "vitest": "^4.0.18"
  }
}
