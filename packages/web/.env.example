# ローカル開発用の設定。`packages/web/.env.local` にコピーして値を入れる。
# `.env.local` は git 管理外（`.gitignore`）。

# Functions（onRequest）の呼び出し側 API キー。
# dev サーバー（Vite）の proxy が Authorization ヘッダーに載せてエミュレータへ転送する。
# VITE_ 接頭辞を付けないこと。付けるとバンドルに焼き込まれ、ブラウザから読めてしまう。
# 値はエミュレータが検証に使うものと一致させること。firebase login 済みなら
# defineSecret が Secret Manager から取得するため、その値を入れる:
#   firebase functions:secrets:access FUNCTIONS_API_KEY --project dev
# 未ログインなら packages/functions/.env.local の値が使われる（README 参照）。
FUNCTIONS_API_KEY=your-api-key

# dev サーバーの proxy 転送先。未設定なら http://localhost:8080。
# Docker で起動する場合は compose が http://host.docker.internal:8080 を設定するため不要。
# API_PROXY_TARGET=http://localhost:8080
