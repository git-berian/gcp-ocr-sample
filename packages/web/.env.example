# UI アクセス制限用パスワード。デプロイ時は必須（未設定だとパスワード画面が出ない）。
# ローカル開発（npm run dev）では未設定でも動く。
# 値はバンドルに含まれるため、UI の目隠しであって Functions の保護にはならない。
# 環境ごとに変えるなら .env.<mode>、全モード共通にするなら .env に設定する。
VITE_APP_PASSWORD=your-password

# 環境固有の Firebase 設定（.env.development / .env.staging / .env.production に設定）
# ここの雛形値は必ず your- で始めること。デプロイ時のガード
# （scripts/deploy-guard.mjs）が未設定のまま出荷されるのを検知できなくなる。
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-firebase-app-id
