{
  "name": "@docai/functions",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "lint": "eslint --no-error-on-unmatched-pattern src/ tests/",
    "lint:fix": "eslint --no-error-on-unmatched-pattern src/ tests/ --fix",
    "format": "prettier --write src/ tests/",
    "format:check": "prettier --check src/ tests/",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "start": "npm run build && firebase emulators:start --only functions --config ../../firebase.json",
    "shell": "npm run build && firebase functions:shell --config ../../firebase.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@anthropic-ai/vertex-sdk": "^0.19.0",
    "@google-cloud/documentai": "^9.5.0",
    "@google/genai": "^2.10.0",
    "firebase-admin": "^13.4.0",
    "firebase-functions": "^7.3.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.3.2",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.56.1",
    "vitest": "^4.0.18"
  }
}
