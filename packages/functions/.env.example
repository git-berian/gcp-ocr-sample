GCP_PROJECT_ID=your-gcp-project-id
DOCAI_LOCATION=us
DOCAI_PROCESSOR_ID=your-processor-id

# Vertex AI Gemini（parseDocumentGemini* 用。GCP_PROJECT_ID は上記を流用）
GEMINI_LOCATION=global
GEMINI_MODEL=gemini-3.5-flash-lite
# generateContent のリクエストタイムアウト（ミリ秒。未設定時は 30000）
GEMINI_TIMEOUT_MS=30000

# Claude（parseDocumentClaude* 用）。トランスポート切替（ADR-0013）
# CLAUDE_TRANSPORT: api（Anthropic 直接 API・既定） | vertex（Vertex AI 経由）
CLAUDE_TRANSPORT=api
CLAUDE_MODEL=claude-opus-4-8
# messages.create のリクエストタイムアウト（ミリ秒。未設定時は 30000）
CLAUDE_TIMEOUT_MS=30000
# vertex 経路のみ使用（GCP_PROJECT_ID は上記を流用・ADC 認証）
# LOCATION は global 推奨。データ所在要件がある場合のみ us/eu 等に変更（ADR-0012 参照）
CLAUDE_LOCATION=global

# ローカル開発用（.env.local に設定）。デプロイ環境では Secret Manager で管理
# FUNCTIONS_API_KEY=your-api-key
# api 経路のみ使用。ANTHROPIC_API_KEY=your-anthropic-api-key
